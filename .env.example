# Keycloak Authentication (optional — leave blank to disable login/register UI)
NUXT_PUBLIC_KEYCLOAK_URL=https://auth.example.com
NUXT_PUBLIC_KEYCLOAK_REALM=my-realm
NUXT_PUBLIC_KEYCLOAK_CLIENT_ID=lms-frontend

# Backend API base URL (for lesson completion, progress tracking, etc.)
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Lyra Chatbot (Pathfinder API)
NUXT_PUBLIC_PATHFINDER_API_URL=http://localhost:8000
NUXT_PUBLIC_PATHFINDER_DOMAINS=dojo.skill-wanderer.com
NUXT_PUBLIC_PATHFINDER_SESSION_EXPIRY_MINUTES=30
NUXT_PUBLIC_PATHFINDER_SESSION_STORAGE=browser

# Resend — newsletter subscription (server-only)
# Subscribers are added directly to Resend contacts, then sent a welcome email.
# There is no confirmation / double opt-in step.
# The API key needs contacts write access, not just email sending.
# On the Cloudflare Worker target, configure these exact env var names.
NUXT_RESEND_API_KEY=
NUXT_RESEND_FROM_EMAIL=noreply@subscribe.skill-wanderer.com
# Optional: Resend segment ID new contacts are added to. Leave empty to skip.
NUXT_RESEND_SEGMENT_ID=
